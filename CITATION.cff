    affiliation: "Department of Applied Plant Science, Chonnam National University"
    orcid: "https://orcid.org/0000-0001-7974-3808"
license: MIT
keywords:
  - gross primary productivity
  - rice
  - maize
  - MODIS
  - AgERA5
  - pooled learning
  - negative transfer
  - spatial validation
url: "https://github.com/jonghanko/rice-maize-gpp-conditional-pooling"
